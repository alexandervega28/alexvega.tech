---
/**
 * Estrellas cercanas — capa independiente del master.
 *
 * El handoff exige capas separadas; el master tiene sol y planeta aplanados,
 * así que esta es la única capa que sí puede moverse por su cuenta.
 * Distribución determinista (PRNG con semilla) para que el build sea estable.
 */
interface Props {
  count?: number;
  seed?: number;
}

const { count = 46, seed = 20260916 } = Astro.props;

let state = seed;
const rand = () => {
  // Mulberry32
  state = (state + 0x6d2b79f5) | 0;
  let t = state;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const stars = Array.from({ length: count }, () => {
  const x = rand() * 100;
  // Sesgo hacia la izquierda: la derecha ya tiene el planeta del master.
  const weight = x < 55 ? 1 : 0.45;
  return {
    x,
    y: rand() * 100,
    r: (0.4 + rand() * 1.1) * weight + 0.25,
    o: (0.25 + rand() * 0.55) * weight,
  };
});
---

<svg
  class="scene__stars"
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    stars.map((s) => (
      <circle
        cx={s.x.toFixed(2)}
        cy={s.y.toFixed(2)}
        r={(s.r * 0.09).toFixed(3)}
        fill="#f3ebdd"
        opacity={s.o.toFixed(2)}
      />
    ))
  }
</svg>
