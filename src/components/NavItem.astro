---
import type { Strings } from '../i18n/ui';

interface Props {
  href: string | null;
  label: string;
  strings: Strings;
  external?: boolean;
  underlined?: boolean;
  arrow?: 'none' | 'external' | 'down';
  class?: string;
}

const {
  href,
  label,
  strings,
  external = false,
  underlined = false,
  arrow = 'none',
  class: className = '',
} = Astro.props;

const glyph = arrow === 'external' ? '↗' : arrow === 'down' ? '↓' : '';
---

{
  href ? (
    <a
      class:list={['link', underlined && 'link--underlined', className]}
      href={href}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <span>{label}</span>
      {glyph && <span aria-hidden="true">{glyph}</span>}
    </a>
  ) : (
    /* Sin destino real: nunca un <a>. Texto marcado como pendiente, con la
       razón disponible para lectores de pantalla y en el tooltip. */
    <span
      class:list={['pending', className]}
      data-state="pending"
      title={strings.pendingHint}
    >
      <span class="pending__dot" aria-hidden="true" />
      <span>{label}</span>
      <span class="visually-hidden">({strings.pending})</span>
    </span>
  )
}
