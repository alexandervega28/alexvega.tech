---
import type { Strings } from '../i18n/ui';
interface Props { strings: Strings }
const { strings } = Astro.props;
---
<div class="loader loader--universe" data-loader data-state="loading" transition:persist="loader">
  <div class="loader__inner">
    <p class="loader__eyebrow">ALEX VEGA / {strings.htmlLang === 'es' ? 'HORIZONTE DE SUCESOS' : 'EVENT HORIZON'}</p>
    <div class="loader__gravity" data-gravity>
    <video class="loader__black-hole" data-black-hole autoplay loop muted playsinline preload="auto" aria-hidden="true" tabindex="-1">
      <source src="/media/black-hole-orbit-nasa.webm" type="video/webm" />
      <source src="/media/black-hole-orbit-nasa.mp4" type="video/mp4" />
    </video>
    <canvas class="loader__tidal" data-tidal aria-hidden="true"></canvas>
    </div>
    <div>
      <p class="loader__label" role="status">{strings.loadingLabel}</p>
      <div class="loader__meter" data-loader-meter aria-hidden="true"><span class="loader__bar" data-loader-bar></span></div>
      <p class="loader__value" data-loader-value aria-hidden="true">0%</p>
    </div>
    <p class="loader__credit">NASA / GODDARD · JEREMY SCHNITTMAN</p>
    <button class="loader__skip" data-skip-intro type="button">{strings.htmlLang === 'es' ? 'Saltar intro' : 'Skip intro'} <span aria-hidden="true">↗</span></button>
  </div>
</div>
<script is:inline>
  // Emergency escape also works if WebGL or the scene bundle fails.
  window.setTimeout(() => {
    const loader = document.querySelector('[data-loader]');
    if (loader?.getAttribute('data-state') !== 'done') {
      loader?.setAttribute('data-state', 'done');
      document.documentElement.classList.add('is-revealed');
      document.querySelector('[data-page]')?.removeAttribute('inert');
      document.querySelector('[data-black-hole]')?.pause();
    }
  }, 18000);
</script>
