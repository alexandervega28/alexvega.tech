---
import { langs } from '../data/site';
import type { Content, Lang } from '../data/site';
interface Props { t: Content; lang: Lang }
const { t, lang } = Astro.props;
---
<header class="header">
  <nav class="nav wrap" aria-label={t.a11y.mainNav}>
    <a class="logo raised" href="#inicio" aria-label={t.a11y.logo}>AV.</a>
    <div class="right">
      <ul class="menu" id="menu">
        {t.nav.map((item, i) => (
          <li><a href={item.href} class:list={['pill', { active: i === 0 }]}>{item.label}</a></li>
        ))}
      </ul>
      <!-- Selector de idioma: enlaces reales a / y /en/ -->
      <div class="lang" role="group" aria-label={t.a11y.language}>
        {langs.map((l) => (
          <a
            href={l.path}
            hreflang={l.code}
            lang={l.code}
            class:list={['lang-opt', { on: l.code === lang }]}
            aria-current={l.code === lang ? 'true' : undefined}
            aria-label={l.name}
          >{l.label}</a>
        ))}
      </div>
      <button
        class="burger raised press"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        aria-label={t.a11y.openMenu}
        data-open={t.a11y.openMenu}
        data-close={t.a11y.closeMenu}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy);
    border-bottom: var(--border) solid var(--ink);
  }
  .nav {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: relative;
  }
  .logo {
    font: 900 clamp(20px, 2vw, 24px) var(--font);
    padding: 6px 14px;
    border-radius: 10px;
    background: var(--sun);
    color: var(--navy);
    text-decoration: none;
    box-shadow: 4px 4px 0 #060f1f;
    border-color: #060f1f;
  }
  .right { display: flex; align-items: center; gap: 14px; }
  .menu { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; }

  /* Selector de idioma: dos mitades de una misma pastilla */
  .lang {
    display: flex;
    border: 3px solid #060f1f;
    border-radius: 999px;
    box-shadow: 4px 4px 0 #060f1f;
    overflow: hidden;
    background: var(--sky);
  }
  .lang-opt {
    font: 700 14px var(--mono);
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 10px 12px;
    color: var(--navy);
    transition: background 0.15s;
  }
  .lang-opt + .lang-opt { border-left: 3px solid #060f1f; }
  .lang-opt:hover { background: var(--white); }
  .lang-opt.on { background: var(--sun); }
  .lang-opt:focus-visible { outline: 3px dashed var(--sun); outline-offset: -6px; }
  .pill {
    display: block;
    font: 700 14px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--sky);
    color: var(--navy);
    border: 3px solid #060f1f;
    box-shadow: 4px 4px 0 #060f1f;
    transition: transform 0.08s, box-shadow 0.08s, background 0.15s;
  }
  .pill:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 #060f1f; }
  .pill.active { background: var(--sun); transform: translate(4px, 4px); box-shadow: 0 0 0 #060f1f; }

  .burger {
    display: none;
    width: 48px;
    height: 44px;
    padding: 0;
    border-radius: 10px;
    background: var(--sun);
    border-color: #060f1f;
    box-shadow: 4px 4px 0 #060f1f;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .burger span { display: block; width: 22px; height: 3px; background: var(--navy); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 1080px) {
    .right { gap: 10px; }
    .menu { gap: 8px; }
    .pill { padding: 9px 11px; font-size: 13px; letter-spacing: 0.03em; }
    .lang-opt { padding: 9px 10px; font-size: 13px; }
  }
  @media (max-width: 760px) {
    .burger { display: flex; }
    .menu {
      position: absolute;
      top: calc(var(--header-h) + 8px);
      right: var(--gutter);
      left: var(--gutter);
      flex-direction: column;
      gap: 12px;
      padding: 16px;
      background: var(--navy);
      border: var(--border) solid #060f1f;
      border-radius: 16px;
      box-shadow: 6px 6px 0 #060f1f;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    }
    .menu.open { opacity: 1; visibility: visible; transform: none; }
    .pill { text-align: center; padding: 14px 16px; font-size: 15px; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const menu = document.getElementById('menu')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.menu a')];

  const setOpen = (open: boolean) => {
    menu.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? burger.dataset.close! : burger.dataset.open!);
  };
  burger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // Al cambiar de idioma se conserva la sección en la que estaba el usuario
  document.querySelectorAll<HTMLAnchorElement>('.lang-opt').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.hash) a.href = a.pathname + location.hash;
    });
  });

  const sections = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!))
    .filter((s): s is HTMLElement => !!s);
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) => {
          const on = a.getAttribute('href') === `#${entry.target.id}`;
          a.classList.toggle('active', on);
          if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
</script>
